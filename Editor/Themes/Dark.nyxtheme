# Nyx editor theme: one value per line, "Name = value". Colours are #RRGGBB or #RRGGBBAA;
# shadows a colour, offset x and y, and blur; glows a colour, distance and strength; glass
# refraction, edge width and rim strength. Values left out keep their defaults.

[Text]
Text                       = #E0E8F2
TextMuted                  = #99A6B5
TextInfo                   = #73A6F2

[Controls]
Frame                      = #2A3646
FrameHovered               = #334153
FramePressed               = #212B38
FrameBorder                = #FFFFFF12
FrameRounding              = 6
FrameBorderWidth           = 1

[Buttons]
ButtonGo                   = #2E703D
ButtonGoHovered            = #38854A
ButtonGoPressed            = #245930
ButtonStop                 = #8F3030
ButtonStopHovered          = #A83D3B
ButtonStopPressed          = #732626

[Accent]
Accent                     = #2472FB
AccentHovered              = #4D8FFF

[Toggles and sliders]
Track                      = #33404F
TrackHovered               = #3D4D5E
Knob                       = #F5F5FA
ToggleWidth                = 1.7
ToggleHeight               = 0.8
ToggleKnobRadius           = 0.32
KnobPressedScale           = 0.88
SliderKnobRadius           = 0.3
SliderTrackHeight          = 0.14
KnobHoverGrowth            = 0.12
ValueGap                   = 8

[Lines]
