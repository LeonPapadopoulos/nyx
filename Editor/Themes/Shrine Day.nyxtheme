# Nyx editor theme "Shrine Day", after the light violet mockup (Shrine Courtyard).
# Nyx editor theme: one value per line, "Name = value". Colours are #RRGGBB or #RRGGBBAA;
# shadows a colour, offset x and y, and blur; glows a colour, distance and strength; glass
# refraction, edge width and rim strength. Values left out keep their defaults.

[Text]
Text                       = #222329
TextMuted                  = #6E6F72
TextInfo                   = #6A4FC9

[Controls]
Frame                      = #F4F4F0
FrameHovered               = #EAEBE6
FramePressed               = #DFE0DA
FrameBorder                = #0000001A
FrameRounding              = 6
FrameBorderWidth           = 1

[Buttons]
